{
  "name": "catus-os",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/runtime.mjs --watch",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "db": "node scripts/postgres.mjs",
    "migrate": "bun --env-file=.local/database.env scripts/migrate.ts",
    "test": "bun test --preload ./tests/setup.ts ./tests",
    "test:e2e": "playwright test",
    "env:init": "node scripts/init-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "bun scripts/test-db.ts",
    "bootstrap:admin": "bun --env-file=.local/database.env scripts/bootstrap-admin.ts",
    "db:roles": "bun scripts/provision-roles.ts",
    "cleanup": "bun --env-file=.local/database.env scripts/cleanup.ts",
    "tls:local": "bun scripts/local-tls.ts",
    "backup:key": "bun scripts/backup-key.ts",
    "backup": "bun --env-file=.local/database.env scripts/backup.ts backup",
    "restore:test": "bun --env-file=.local/restore.env scripts/backup.ts restore",
    "homologation:check": "bun --env-file=.local/database.env scripts/check-homologation.ts",
    "restore:prepare": "bun scripts/prepare-restore.ts",
    "start": "node scripts/runtime.mjs",
    "ai:worker": "node scripts/runtime.mjs --ai-worker",
    "ai:check": "bun scripts/check-ai.ts",
    "delivery:runner": "node scripts/delivery-runner.mjs",
    "delivery:gateway": "node scripts/delivery-runner.mjs --gateway",
    "delivery:token": "bun --env-file=.local/database.env scripts/delivery-runner-token.ts"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "pg": "8.16.3",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/bun": "1.3.10",
    "@types/pg": "8.16.0",
    "bun": "1.4.4",
    "embedded-postgres": "18.3.0-beta.17",
    "jose": "6.2.14",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.4.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
