{
  "name": "catus-os",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "db": "node scripts/postgres.mjs",
    "migrate": "bun scripts/migrate.ts",
    "test": "bun test ./tests",
    "test:e2e": "playwright test",
    "env:init": "node scripts/init-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pg": "8.16.3",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/bun": "1.3.10",
    "@types/pg": "8.16.0",
    "bun": "1.4.4",
    "embedded-postgres": "18.3.0-beta.17",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.4.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
