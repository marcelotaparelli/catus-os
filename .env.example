# DATABASE_URL is local administrative tooling only; the runtime launcher removes it.
DATABASE_URL=postgres://catus:catus_local_only@127.0.0.1:5432/catus
TEST_DATABASE_URL=postgres://catus:catus_local_only@127.0.0.1:5432/catus_test
APP_ORIGIN=http://127.0.0.1:5173
PORT=3000
# All three OIDC fields must be configured together. Empty means login is blocked.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google Workspace: verify the hd claim, not just an email suffix.
OIDC_HOSTED_DOMAIN=

# Generated privately by npm run db:roles: RUNTIME_DATABASE_URL, MIGRATION_DATABASE_URL, MAINTENANCE_DATABASE_URL
# HTTPS homologation: APP_ORIGIN=https://localhost:3443, PORT=3443
# TLS_CERT_FILE=.local/tls/server.crt
# TLS_KEY_FILE=.local/tls/server.key

# M2: disabled until provider credentials, model, pricing and data policy are configured.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_DATA_POLICY_ID=
LLM_CLIENT_DATA_ALLOWED=false
# USD per million tokens; explicit prices for the selected test model, never guessed.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=20000
# AI_WORKER_DATABASE_URL is generated privately by db:roles; never expose it to the web process.

# M5 is OFF. API receives only the public allowlist and operator attestation.
# Codex/GitHub/gateway/runner credentials belong to separate private service environments.
DELIVERY_ENABLED=false
DELIVERY_REPOSITORIES_FILE=
DELIVERY_RUNNER_ATTESTATION=

# M6.1 ClickUp, read-only. OFF until enabled AND fully configured.
CLICKUP_ENABLED=false
# Only the worker process receives the token; the web launcher removes it.
CLICKUP_API_TOKEN=
# The one Catus organization and ClickUp workspace this token belongs to.
CLICKUP_ORGANIZATION_ID=
CLICKUP_WORKSPACE_ID=
CLICKUP_REQUESTS_PER_MINUTE=60
CLICKUP_SYNC_MINUTES=15
# CLICKUP_WORKER_DATABASE_URL is generated privately by clickup:role.
